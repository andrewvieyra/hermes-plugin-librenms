{
  "description": "Add branch-rtr7 over SNMPv3; credentials come from the environment (requires allow_device_add: true)",
  "operations": [
    {"op": "create", "resource": "device",
     "data": {"hostname": "branch-rtr7.example.net", "snmpver": "v3", "authlevel": "authPriv",
              "authname": {"env": "LIBRENMS_SNMP_V3_USER"}, "authpass": {"env": "LIBRENMS_SNMP_V3_AUTH"},
              "authalgo": "SHA-256", "cryptopass": {"env": "LIBRENMS_SNMP_V3_PRIV"}, "cryptoalgo": "AES-256",
              "location": "NYC-2", "override_sysLocation": true, "poller_group": 1}}
  ]
}
